<Window x:Class="GamingClub.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GamingClub — Администратор" Height="620" Width="920"
        MinHeight="460" MinWidth="680" Background="#101827">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="GamingClub" Foreground="White" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Карта игрового зала · данные из SQL Server через API"
                       Foreground="#AAB7CE" Margin="0,6,0,20"/>
            <Border Background="#1D2C44" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Foreground="White" FontWeight="SemiBold" Text="Вход администратора"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="LoginInput" Width="160" Height="30" Margin="0,0,8,0"
                                 ToolTip="Логин" />
                        <PasswordBox x:Name="PasswordInput" Width="170" Height="30" Margin="0,0,8,0"/>
                        <Button Content="Войти" Width="90" Height="30" Click="Login_Click"/>
                        <Button Content="Выйти" Width="90" Height="30" Margin="8,0,0,0"
                                Click="Logout_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="AuthStatus" Text="Не авторизован" Foreground="#BFD7F7"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#1D2C44" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Foreground="White" FontWeight="SemiBold" Text="Загрузка игрового зала"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="ReportFrom" Width="220" Height="30" Margin="0,0,8,0"
                                 Text="2026-11-18T12:00:00Z" ToolTip="Начало UTC"/>
                        <TextBox x:Name="ReportTo" Width="220" Height="30" Margin="0,0,8,0"
                                 Text="2026-11-18T13:00:00Z" ToolTip="Конец UTC"/>
                        <Button Content="Рассчитать" Width="110" Height="30" Click="Report_Click"/>
                        <Button Content="Экспорт CSV" Width="115" Height="30"
                                Margin="8,0,0,0" Click="ExportReport_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ReportStatus" Foreground="#BFD7F7"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Отчёт доступен только администратору после входа."/>
                </StackPanel>
            </Border>
            <Expander Header="Тарифы — создание и отключение" Foreground="White"
                      Background="#1D2C44" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Foreground="#BFD7F7" TextWrapping="Wrap"
                               Text="Создание нового тарифа не меняет условия уже существующих броней."/>
                    <WrapPanel Margin="0,8,0,8">
                        <TextBox x:Name="TariffNameInput" Width="170" Height="30" Margin="0,0,8,6"
                                 ToolTip="Название тарифа" Text="Новый тариф"/>
                        <ComboBox x:Name="TariffTypeInput" Width="145" Height="30" Margin="0,0,8,6"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="HOURLY"/>
                            <ComboBoxItem Content="PACKAGE"/>
                            <ComboBoxItem Content="NIGHT"/>
                            <ComboBoxItem Content="HAPPY_HOURS"/>
                        </ComboBox>
                        <TextBox x:Name="TariffPriceInput" Width="85" Height="30" Margin="0,0,8,6"
                                 Text="120" ToolTip="Цена, руб."/>
                        <TextBox x:Name="TariffMinutesInput" Width="100" Height="30" Margin="0,0,8,6"
                                 Text="" ToolTip="Минуты только для PACKAGE"/>
                        <TextBox x:Name="TariffFromInput" Width="85" Height="30" Margin="0,0,8,6"
                                 ToolTip="Для NIGHT/HAPPY_HOURS начало HH:mm"/>
                        <TextBox x:Name="TariffToInput" Width="85" Height="30" Margin="0,0,8,6"
                                 ToolTip="Для NIGHT/HAPPY_HOURS конец HH:mm"/>
                        <Button Content="Создать" Height="30" Padding="12,0" Margin="0,0,8,6"
                                Click="CreateTariff_Click"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Обновить тарифы" Height="30" Padding="12,0"
                                Margin="0,0,10,0" Click="RefreshTariffs_Click"/>
                        <TextBox x:Name="DeactivateTariffIdInput" Width="100" Height="30"
                                 ToolTip="ID тарифа для отключения" Margin="0,0,8,0"/>
                        <Button Content="Отключить по ID" Padding="12,0" Height="30"
                                Click="DeactivateTariff_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="TariffStatus" Foreground="#BFD7F7" TextWrapping="Wrap"
                               Text="Тарифы доступны только администратору."/>
                    <DataGrid x:Name="TariffsTable" Height="160" Margin="0,8,0,0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding TariffId}" Width="50"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding TariffType}" Width="130"/>
                            <DataGridTextColumn Header="Руб." Binding="{Binding PriceRub}" Width="75"/>
                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Expander>
            <Expander Header="Бронирования — последние 100 записей" Foreground="White"
                      Background="#1D2C44" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <Button Content="Обновить бронирования" Height="30" Width="190"
                            HorizontalAlignment="Left" Click="RefreshBookings_Click"/>
                    <TextBlock x:Name="BookingsStatus" Foreground="#BFD7F7" Margin="0,8,0,0"
                               Text="Требуется вход администратора."/>
                    <DataGrid x:Name="BookingsTable" Height="210" Margin="0,8,0,0"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Бронь" Binding="{Binding BookingId}" Width="60"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
                            <DataGridTextColumn Header="ПК" Binding="{Binding SeatNumber}" Width="55"/>
                            <DataGridTextColumn Header="Начало UTC" Binding="{Binding StartUtc}" Width="160"/>
                            <DataGridTextColumn Header="Конец UTC" Binding="{Binding EndUtc}" Width="160"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Expander>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Обновить места" Width="160" Height="34" Click="Refresh_Click"/>
                <TextBlock x:Name="StatusText" Foreground="#BFD7F7" VerticalAlignment="Center"
                           Margin="16,0,0,0" Text="Ожидание загрузки"/>
            </StackPanel>
            <Border Background="#1D2C44" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Foreground="White" FontWeight="SemiBold"
                               Text="Продление игровой сессии (требуется вход администратора)"/>
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <TextBox x:Name="BookingIdInput" Width="110" Height="30" Margin="0,0,8,0"
                                 ToolTip="ID брони" Text="1"/>
                        <TextBox x:Name="ExtensionTimeInput" Width="260" Height="30" Margin="0,0,8,0"
                                 ToolTip="Новый конец в UTC, например 2026-11-20T16:00:00Z"
                                 Text="2026-11-20T16:00:00Z"/>
                        <Button Content="Продлить" Width="110" Height="30" Click="Extend_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ExtensionStatus" Foreground="#BFD7F7" TextWrapping="Wrap"
                               Margin="0,8,0,0" Text="Введите ID брони и новую дату UTC."/>
                </StackPanel>
            </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Seats}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="138" Height="90" Margin="5" CornerRadius="9"
                                Background="#263754" BorderBrush="#476181" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SeatNumber, StringFormat=ПК №{0}}"
                                           Foreground="White" FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Status}" Foreground="#BFD7F7"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
